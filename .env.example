# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pos_ecommerce_db

# Security & Authentication (Dual Token Architecture)
JWT_ACCESS_SECRET=super_secret_access_key_pos_ecommerce_2026_secure!
JWT_REFRESH_SECRET=super_secret_refresh_key_pos_ecommerce_2026_secure!
OLD_JWT_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Rate Limiting & Brute-Force Protection
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MS=900000

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ID Generation Config
ID_CHARSET=23456789ABCDEFGHJKLMNPQRSTUVWXYZ
PRODUCT_ID_PREFIX=PRD
TRANSACTION_ID_PREFIX=TXN
